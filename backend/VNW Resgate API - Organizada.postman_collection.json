  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Cadastro e Login",
          "item": [
            {
              "name": "POST - Registrar novo usuário",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pessoa Exemplo\",\n  \"email\": \"pessoa@example.com\",\n  \"password\": \"Senha123\",\n  \"phone\": \"11999999999\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "register"
                  ]
                },
                "description": "Cria um novo usuário com role padrão 'people'. Retorna token JWT automaticamente."
              },
              "response": []
            },
            {
              "name": "POST - Login como Administrador (admin@fingestao.com)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  if (body.data && body.data.token) {",
                      "    pm.collectionVariables.set('token', body.data.token);",
                      "    pm.collectionVariables.set('adminToken', body.data.token);",
                      "  }",
                      "  if (body.data && body.data.user && body.data.user.id_code) pm.collectionVariables.set('userIdCode', body.data.user.id_code);",
                      "  if (body.data && body.data.user && body.data.user.id) pm.collectionVariables.set('userId', body.data.user.id);",
                      "  console.log('Admin autenticado com sucesso! Token salvo na collection.');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ]
                },
                "description": "Realiza login com a conta de Administrador (admin@fingestao.com). Salva o token JWT de admin automaticamente na variável {{token}} para uso em todas as outras requisições protegidas da collection."
              },
              "response": []
            },
            {
              "name": "POST - Login com email e senha",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);",
                      "  if (body.data && body.data.user && body.data.user.id_code) pm.collectionVariables.set('userIdCode', body.data.user.id_code);",
                      "  if (body.data && body.data.user && body.data.user.id) pm.collectionVariables.set('userId', body.data.user.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"pessoa@example.com\",\n  \"password\": \"Senha123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ]
                },
                "description": "Autentica usuário com email e senha. Salva token automaticamente na variável {{token}}."
              },
              "response": []
            },
            {
              "name": "POST - Login com Google (Firebase)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);",
                      "  if (body.data && body.data.user && body.data.user.id_code) pm.collectionVariables.set('userIdCode', body.data.user.id_code);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/google",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "google"
                  ]
                },
                "description": "Login via Google OAuth usando Firebase ID Token. Cria usuário se não existir."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Gerenciamento de Sessão",
          "item": [
            {
              "name": "GET - Obter usuário autenticado (/me)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/me",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "me"
                  ]
                },
                "description": "Retorna os dados completos do usuário logado (incluindo plano associado)."
              },
              "response": []
            },
            {
              "name": "POST - Renovar token JWT",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/refresh",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "refresh"
                  ]
                },
                "description": "Renova o token JWT usando o token atual. Salva novo token automaticamente."
              },
              "response": []
            },
            {
              "name": "POST - Logout (invalidar token)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.unset('token');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/logout",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "logout"
                  ]
                },
                "description": "Invalida o token JWT atual na blocklist. Limpa variável {{token}} automaticamente."
              },
              "response": []
            }
          ]
        }
      ]
    },
