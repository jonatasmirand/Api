                  "path": [
                    "api",
                    "v1",
                    "uploads",
                    "oauth",
                    "init"
                  ]
                },
                "description": "Inicia fluxo OAuth2 do Google Drive. Redireciona para página de consentimento do Google."
              },
              "response": []
            },
            {
              "name": "GET - Iniciar fluxo OAuth (/upload)",
